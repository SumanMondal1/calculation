# Copy this file to .env and fill in the real value. .env is gitignored -
# never commit real credentials.

# Supabase: Project Settings -> Database -> Connection string -> URI
# (use the "Transaction pooler" connection string on port 6543 if you hit
# connection-limit issues on the free tier; the direct 5432 one works too
# for a single small backend instance).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres
