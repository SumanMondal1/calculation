# Copy this file to .env and fill in the real value. .env is gitignored -
# never commit real credentials.

# Supabase: Project Settings -> Connect -> Connection string -> "Session
# pooler" (NOT "Direct connection" - that one is IPv6-only and will fail
# with ENOTFOUND on most Indian ISPs/networks; Session pooler works over
# plain IPv4). Note the username becomes "postgres.<project-ref>" for the
# pooler, not just "postgres".
#
# If your database password contains special characters (@, :, /, etc),
# percent-encode them in the URL - e.g. "@" becomes "%40".
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres
